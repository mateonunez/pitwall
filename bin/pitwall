#!/bin/sh
# pitwall: see and steer coding agents from tmux.
set -eu

# Resolve a symlink (~/.local/bin/pitwall → the checkout), so pitwall can live on your PATH.
DIR=$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)
HOOK="$DIR/bin/pitwall-hook"
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/pitwall
TAB=$(printf '\t')

usage() {
  cat <<'EOF'
pitwall: see and steer coding agents from tmux

  pitwall ls [--json]       every lane, the ones that need you first, with a ref (@1, @2…)
  pitwall peek @N [lines]   the last lines of a lane
  pitwall go @N             jump to a lane
  pitwall answer @N <1|2|3>  answer a lane that asks (one key, never to a lane that works)
  pitwall send @N <text>    write to a lane's agent and send it
  pitwall next              jump to the next lane that is asking or done (cycles)
  pitwall dash              the dashboard (prefix Space opens it in a popup); board is the old name
  pitwall stats [@N]        model, context and tokens per lane, from the agents' transcripts
  pitwall quota [--refresh] Claude and Codex usage limits, from CodexBar
  pitwall saved             the lanes pitwall can bring back after tmux dies
  pitwall restore [--dry]   reopen them: the session, window and pane, resuming each agent
  pitwall forget <id>       drop a saved lane (a session id or its first characters)
  pitwall new <name> [--agent claude|codex]   a worktree (gwm), a window there and an agent in it
  pitwall done @N           review the lane's diff (lumen), then remove its worktree if you say so
  pitwall ot connect <token> [--url URL]      send lane states to OpenTimeline (status, flush, disconnect)
  pitwall ot bell <person-token>              Needs you's count in the status line (off to stop)
  pitwall ws [new|go|rename|close] …          workspaces (tmux sessions): list them, or manage one
  pitwall up [name] [--dry] · --list · --save [ws]  a workspace from a small file: tabs, agents, servers, nvim
  pitwall move <@N|window> <workspace>        move a lane's window, agents still running, to a workspace
  pitwall install [--write] show (or add) the hook lines for Claude Code and Codex
  pitwall doctor            what is missing; exits 1 when something is
  pitwall demo [stop]       a throwaway tmux server with fake lanes, to look at pitwall
  pitwall keys              every key, in tmux and in the dashboard
  pitwall --version         the installed version
EOF
}

# One row per lane (a pane running an agent), tab-separated, ordered by what needs you:
# rank state session window pane-id since harness title transcript session-id urgent folder question choices. A window with several panes names them window.N.
lanes() {
  fmt=$(tmux show -gqv @pitwall-state-fmt)
  [ -n "$fmt" ] || { echo "pitwall: not loaded in this tmux server (run pitwall.tmux)" >&2; exit 1; }
  tmux list-panes -a -F "#{E:@pitwall-state-fmt}	#{session_name}	#{window_name}#{?#{>:#{window_panes},1},.#{pane_index},}	#{pane_id}	#{@pitwall_since}	#{?#{@pitwall_harness},#{@pitwall_harness},#{?#{==:#{pane_current_command},codex},codex,#{?#{m/r:^(claude|[0-9.]+)$,#{pane_current_command}},claude,}}}	#{pane_title}	#{@pitwall_transcript}	#{@pitwall_session}	#{?#{@pitwall_urgent},urgent,-}	#{pane_current_path}	#{@pitwall_question}	#{@pitwall_choices}" |
    awk -F '\t' 'BEGIN { OFS = "\t"; split("asking done working idle gone", o, " "); for (i in o) rank[o[i]] = i }
      $1 != "" {
        t = $7; sub(/^\[ [^]]* \] Action Required \| /, "", t)  # Codex waiting for you (it blinks "[ ! ]" / "[ . ]")
        if (t ~ /^[^A-Za-z0-9]+ /) sub(/^[^ ]+ /, "", t)           # spinner or ✳ in front of the task
        sub(/ \| [^|]*$/, "", t); $7 = t                         # Codex appends " | <dir>"
        print rank[$1], $0
      }' |
    sort -t "$(printf '\t')" -k1,1n -k3,3 -k4,4
}

# shortcut: refs are positions in the current ordering, valid until the lanes move; stable ids come with the TS CLI.
resolve() {
  n=${1#@}
  lanes | awk -F '\t' -v n="$n" 'NR == n { print $5; found = 1 } END { exit !found }' ||
    { echo "pitwall: no lane $1 (see pitwall ls)" >&2; exit 1; }
}

cmd_ls() {
  now=$(date +%s)
  lanes | awk -F '\t' -v now="$now" -v json="${1:-}" '
    function age(s) { if (s == "") return "—"; d = now - s; return d < 60 ? d "s" : d < 3600 ? int(d / 60) "m" : int(d / 3600) "h" }
    function q(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return "\"" s "\"" }
    {
      t = $8
      if (json == "--json")
        printf "%s{\"ref\":\"@%d\",\"state\":%s,\"session\":%s,\"window\":%s,\"id\":%s,\"since\":%s,\"harness\":%s,\"task\":%s,\"urgent\":%s,\"folder\":%s,\"question\":%s,\"choices\":%s}", (NR > 1 ? ",\n " : "[\n "), NR, q($2), q($3), q($4), q($5), ($6 == "" ? "null" : $6), q($7), q(t), ($11 == "urgent" ? "true" : "false"), q($12), ($13 == "" ? "null" : q($13)), ($14 == "" ? "null" : q($14))
      else
        printf "@%-2d %-22s %-8s %4s  %-7s %s\n", NR, $3 "/" $4, $2, age($6), $7, ($2 == "asking" && $13 != "" ? $13 "  " $14 : t)
    }
    END { if (json == "--json") print (NR ? "\n]" : "[]") }'
}

cmd_peek() {
  id=$(resolve "${1:?usage: pitwall peek @N}")
  tmux capture-pane -p -t "$id" | awk 'NF' | tail -n "${2:-15}"
}

# Jump to a pane in any session: its session, its window, then the pane itself.
jump() { tmux switch-client -t "$1" \; select-window -t "$1" \; select-pane -t "$1"; }

cmd_go() { jump "$(resolve "${1:?usage: pitwall go @N}")"; }

# answer @N <1|2|3|…>: one key to a lane that is asking, as if typed there; never to a lane that works.
cmd_answer() {
  pane=$(resolve "${1:?usage: pitwall answer @N <1|2|3>}"); key=${2:?usage: pitwall answer @N <1|2|3>}
  case $key in [0-9] | y | n | Y | N) ;; *) echo "pitwall answer: one of the numbered answers (1, 2, 3…), or y / n" >&2; exit 1 ;; esac
  [ "$(tmux display -p -t "$pane" '#{@pitwall_state}')" = asking ] || { echo "pitwall answer: $1 is not asking" >&2; exit 1; }
  tmux send-keys -t "$pane" "$key"
  echo "answered $key to $1"
}

# send @N <message>: a message typed into a lane's agent and sent, as in the dashboard (ctrl-s); not to a lane gone.
cmd_send() {
  pane=$(resolve "${1:?usage: pitwall send @N <message>}"); shift
  [ $# -gt 0 ] || { echo "usage: pitwall send @N <message>" >&2; exit 1; }
  [ "$(tmux display -p -t "$pane" '#{@pitwall_state}')" = gone ] && { echo "pitwall send: its agent has gone" >&2; exit 1; }
  tmux send-keys -t "$pane" -l -- "$*" && tmux send-keys -t "$pane" Enter
  echo "sent to $1"
}

# Visiting a window: its panes that finished while you were away become idle (the tmux hook calls this).
cmd_seen() {
  tmux list-panes -t "${1:?usage: pitwall seen <window>}" -F '#{pane_id} #{@pitwall_state}' | while read -r pane state; do
    if [ "$state" = done ]; then tmux set -p -t "$pane" @pitwall_state idle; fi # not &&: under set -e a false test ending the loop fails the command
  done
  tmux refresh-client -S 2>/dev/null || true
}

# The lane after this one among those asking or done, wrapping; pressed again it cycles through them.
next_id() {
  cur=$(tmux display -p '#{pane_id}' 2>/dev/null || true)
  lanes | awk -F '\t' -v cur="$cur" '$2 == "asking" || $2 == "done" { id[++n] = $5; if ($5 == cur) at = n }
    END { if (n && !(n == 1 && at == 1)) print id[at % n + 1] }'
}

cmd_next() {
  id=$(next_id)
  if [ "${1:-}" = --dry ]; then echo "$id"; return; fi
  if [ -n "$id" ]; then jump "$id"; else tmux display-message "pitwall: nothing else needs you"; fi
}

# --- metrics -----------------------------------------------------------------------------------------------

# stats [@N]: model, context use and tokens for each lane (or one), read from the transcript each hook recorded.
# stats --today: per lane, today's time working and time asking (waiting on you), from the hook's ledger.
stats_today() {
  f=$STATE/ledger/$(date +%F)
  [ -f "$f" ] || { [ "${1:-}" = --plain ] || echo "no ledger for today yet: it starts with the next state change"; return 0; }
  awk -F '\t' -v now="$(date +%s)" -v plain="${1:-}" '
    { if ($2 in at) { d = $1 - at[$2]; if (st[$2] == "working") w[$2] += d; else if (st[$2] == "asking") a[$2] += d }
      at[$2] = $1; st[$2] = $5; name[$2] = $4 }
    END {
      for (p in at) { d = now - at[p]; if (st[p] == "working") w[p] += d; else if (st[p] == "asking") a[p] += d }
      if (plain != "--plain") printf "%-22s %9s %9s\n", "LANE", "WORKING", "ASKING"
      for (p in at) if (plain == "--plain") printf "%s\t%s\t%d\t%d\n", p, name[p], w[p], a[p]
        else printf "%-22s %8dm %8dm\n", name[p], w[p] / 60, a[p] / 60
    }' "$f"
}

cmd_stats() {
  case ${1:-} in --today) shift; stats_today "$@"; return ;; esac
  rows=$(lanes)
  [ -n "${1:-}" ] && rows=$(printf '%s\n' "$rows" | awk -v n="${1#@}" 'NR == n')
  US=$(printf '\037') # not a tab: `read` merges consecutive tabs, so an empty field would shift the rest
  printf '%s\n' "$rows" | awk 'NF' | tr '\t' '\037' | while IFS="$US" read -r _ state session window _ _ harness _ transcript sid _; do
    printf '%s\t%s\t%s\t%s\n' "$session/$window" "$state" "$harness" "$("$DIR/bin/pitwall-stats" "$harness" "$transcript" "$sid")"
  done | awk -F '\t' 'BEGIN { printf "%-22s %-8s %-7s %-18s %5s %9s %9s %10s %6s\n", "LANE", "STATE", "AGENT", "MODEL", "CTX", "TOKENS", "OUT", "COST", "TURNS" }
    { printf "%-22s %-8s %-7s %-18s %5s %9s %9s %10s %6s\n", $1, $2, $3, ($4 == "" ? "-" : $4), ($5 == "" ? "-" : $5 "%"), ($8 == "" ? "-" : $8), ($9 == "" ? "-" : $9), ($14 == "" ? "-" : "$" $14), ($15 == "" ? "-" : $15) }'
}

# quota [--refresh]: CodexBar's usage limits, rendered once into @pitwall_quota for the status line and the dashboard.
cmd_quota() {
  bar=$(tmux show -gqv @pitwall-codexbar 2>/dev/null)
  bar=${bar:-/Applications/CodexBar.app/Contents/Helpers/CodexBarCLI}
  if [ "${1:-}" != --refresh ]; then tmux show -gqv @pitwall_quota_plain 2>/dev/null; return; fi
  [ -x "$bar" ] || return 0
  tmux set -g @pitwall_quota_at "$(date +%s)" # claim the refresh first, so lanes finishing together run it once
  "$bar" usage --format json --provider both 2>/dev/null | "$DIR/bin/pitwall-quota" | {
    IFS= read -r fmt || true # nothing from CodexBar is not a failure
    IFS= read -r plain || true
    IFS= read -r data || true
    if [ -n "$plain" ]; then tmux set -g @pitwall_quota "$fmt" \; set -g @pitwall_quota_plain "$plain" \; set -g @pitwall_quota_data "$data"; fi
  }
}

# --- workspaces --------------------------------------------------------------------------------------------
# A workspace is a tmux session. Moving a lane between workspaces is `move-window`: its agents keep running,
# and their restore records follow them, so a crash brings them back where they now live.

# Each workspace with its windows and its lanes by state: name attached windows asking done working idle.
workspaces() {
  counts=$(lanes 2>/dev/null | awk -F '\t' '{ n[$3 FS $2]++ } END { for (k in n) print k FS n[k] }')
  tmux list-sessions -F '#{session_name}	#{session_attached}	#{session_windows}' | while IFS="$TAB" read -r name attached windows; do
    printf '%s\n' "$counts" | awk -F '\t' -v s="$name" -v a="$attached" -v w="$windows" -v OFS='\t' '
      $1 == s { c[$2] = $3 } END { print s, a, w, c["asking"] + 0, c["done"] + 0, c["working"] + 0, c["idle"] + c["gone"] + 0 }'
  done
}

# The restore records of a window's agents now point where the window lives.
follow() {
  tmux list-panes -t "$1" -F '#{@pitwall_session}	#{session_name}	#{window_index}	#{window_name}	#{pane_index}' 2>/dev/null |
    while IFS="$TAB" read -r sid sname widx wname pidx; do
      f="$STATE/lanes/$sid"
      [ -n "$sid" ] && [ -f "$f" ] || continue
      awk -F '\t' -v OFS='\t' -v s="$sname" -v w="$widx" -v n="$wname" -v p="$pidx" '{ $4 = s; $5 = w; $6 = n; $7 = p; print }' "$f" >"$f.tmp" && mv -f "$f.tmp" "$f"
    done
}

# tmux renumbers a session (renumber-windows) when a window closes, not when one moves out: close that gap too,
# and keep the records in step. No session: every one. A moved window's own record follows it as well.
cmd__reindex() {
  { if [ -n "${1:-}" ]; then echo "$1"; else tmux list-sessions -F '#{session_name}'; fi; } | while IFS= read -r s; do
    tmux move-window -r -t "=$s:" 2>/dev/null || continue
    for w in $(tmux list-windows -t "=$s" -F '#{window_id}'); do follow "$w"; done
  done
  [ -n "${2:-}" ] && follow "$2"
  return 0
}

# Move a window (by id) to a workspace, creating it if needed.
move_window() {
  win=$1 ws=$2
  name=$(tmux display -p -t "$win" '#{window_name}') || { echo "pitwall: no such window" >&2; return 1; }
  if tmux has-session -t "=$ws" 2>/dev/null; then
    tmux move-window -d -s "$win" -t "=$ws:"
  else
    # A new session starts with a shell window: the moved window takes its place.
    placeholder=$(tmux new-session -d -P -F '#{window_index}' -s "$ws" -c "$(tmux display -p -t "$win" '#{pane_current_path}')")
    tmux move-window -d -k -s "$win" -t "=$ws:$placeholder"
    created=" (new workspace)"
  fi
  follow "$win"
  echo "moved $name to $ws${created:-}"
}

cmd_move() {
  src=${1:?usage: pitwall move <@N|window|session:window> <workspace>}
  ws=${2:?usage: pitwall move <@N|window|session:window> <workspace>}
  case $src in
    @*) win=$(tmux display -p -t "$(resolve "$src")" '#{window_id}') ;;
    *:*) win=$(tmux display -p -t "=$src" '#{window_id}' 2>/dev/null) ;;
    *)
      win=$(tmux list-windows -a -F '#{window_id}	#{window_name}' | awk -F '\t' -v n="$src" '$2 == n { print $1 }')
      case $win in *[[:space:]]*) echo "pitwall: more than one window is called $src; use <session>:$src" >&2; exit 1 ;; esac
      ;;
  esac
  [ -n "$win" ] || { echo "pitwall: no window $src" >&2; exit 1; }
  move_window "$win" "$ws"
}

cmd_ws() {
  case ${1:-ls} in
    ls)
      workspaces | awk -F '\t' '{
        lanes = ""
        if ($4) lanes = lanes "◆" $4 " "; if ($5) lanes = lanes "✓" $5 " "; if ($6) lanes = lanes "⠙" $6 " "; if ($7) lanes = lanes "○" $7 " "
        printf "%s %-18s %2d window%s  %s\n", ($2 > 0 ? "●" : " "), $1, $3, ($3 == 1 ? " " : "s"), lanes }'
      ;;
    new)
      ws=${2:?usage: pitwall ws new <name> [dir]}
      tmux new-session -d -s "$ws" -c "${3:-$HOME}" && echo "workspace $ws"
      ;;
    go) tmux switch-client -t "=${2:?usage: pitwall ws go <name>}" ;;
    rename)
      old=${2:?usage: pitwall ws rename <old> <new>} new=${3:?usage: pitwall ws rename <old> <new>}
      tmux rename-session -t "=$old" "$new" || exit 1
      for w in $(tmux list-windows -t "=$new" -F '#{window_id}'); do follow "$w"; done
      echo "workspace $old is now $new"
      ;;
    close)
      ws=${2:?usage: pitwall ws close <name>}
      busy=$(lanes | awk -F '\t' -v s="$ws" '$3 == s && $2 != "gone"' | wc -l | tr -d ' ')
      if [ "$busy" != 0 ] && [ "${3:-}" != --force ]; then
        echo "pitwall: $ws has $busy agent lane(s); move them first, or close with --force (their agents stop)" >&2
        exit 1
      fi
      tmux kill-session -t "=$ws" && echo "closed $ws"
      ;;
    _rows) workspaces ;;
    *) echo "usage: pitwall ws [ls] | new <name> [dir] | go <name> | rename <old> <new> | close <name> [--force]" >&2; exit 1 ;;
  esac
}

# --- OpenTimeline ------------------------------------------------------------------------------------------

# ot connect <token-file> [--url URL] | status | flush | disconnect | bell <person-token-file> | bell --refresh.
# The seat's token reports signals. Needs you belongs to a person, so its count needs that person's token (bell).
cmd_ot() {
  conf=${XDG_CONFIG_HOME:-$HOME/.config}/pitwall/opentimeline
  bellconf=${XDG_CONFIG_HOME:-$HOME/.config}/pitwall/opentimeline-bell
  case ${1:-status} in
    bell)
      case ${2:-} in
        --refresh)
          [ -f "$bellconf" ] || return 0
          tmux set -g @pitwall_bell_at "$(date +%s)"
          url=$(head -1 "$conf" 2>/dev/null || echo http://127.0.0.1:4431)
          n=$(curl -fsS -m 5 -H "authorization: Bearer $(cat "$(cat "$bellconf")")" "$url/v1/attention" 2>/dev/null |
            python3 -I -c 'import json,sys; d=json.load(sys.stdin); print(len(d.get("items", d) if isinstance(d, dict) else d))' 2>/dev/null) || return 0
          tmux set -g @pitwall_bell "$n"
          ;;
        off) rm -f "$bellconf"; tmux set -gu @pitwall_bell; echo "opentimeline: bell off" ;;
        '') echo "usage: pitwall ot bell <person-token-file> | --refresh | off" >&2; exit 1 ;;
        *)
          [ -f "$2" ] || { echo "pitwall: no token file at $2" >&2; exit 1; }
          mkdir -p "$(dirname "$bellconf")"
          printf '%s\n' "$(cd "$(dirname "$2")" && pwd)/$(basename "$2")" >"$bellconf"
          cmd_ot bell --refresh
          echo "opentimeline: bell on, Needs you has $(tmux show -gqv @pitwall_bell 2>/dev/null || echo ?) item(s)"
          ;;
      esac
      ;;
    connect)
      file=${2:?usage: pitwall ot connect <token-file> [--url URL]}
      [ -f "$file" ] || { echo "pitwall: no token file at $file" >&2; exit 1; }
      url=http://127.0.0.1:4431
      [ "${3:-}" = --url ] && url=${4:?usage: pitwall ot connect <token-file> --url URL}
      mkdir -p "$(dirname "$conf")"
      printf '%s\n%s\n' "$url" "$(cd "$(dirname "$file")" && pwd)/$(basename "$file")" >"$conf"
      "$DIR/bin/pitwall-signal" --status
      ;;
    status) "$DIR/bin/pitwall-signal" --status ;;
    flush) "$DIR/bin/pitwall-signal" ;;
    disconnect) rm -f "$conf" && echo "opentimeline: disconnected" ;;
    *) echo "usage: pitwall ot connect <token-file> [--url URL] | status | flush | disconnect" >&2; exit 1 ;;
  esac
}

# _escalate <pane> <since>: the hook's ten-minute check. Still asking since then: red in tmux, urgent in OpenTimeline.
# _question <pane> <since>: what a lane that asks is asking, read once from its screen (never the transcript), kept on
# the pane as @pitwall_question and @pitwall_choices until it moves on. "Do you want to proceed?" under a command
# becomes "Allow <command>?"; the numbered answers become "1 Yes · 2 No". Prints both, tab-separated.
question_of() { # question_of: the screen on stdin → question <tab> choices
  sed 's/[│╭╮╰╯]//g; s/^[[:space:]]*//; s/[[:space:]]*$//' | awk 'NF { l[++n] = $0 }
    END {
      for (i = n; i > 0 && i > n - 30; i--) if (l[i] ~ /\?/ && l[i] !~ /^[0-9]\./ && l[i] !~ /^(❯|›|>) *[0-9]\./) { qi = i; break }
      if (!qi) exit
      q = l[qi]; rest = ""
      if (match(q, /\? +/)) { rest = substr(q, RSTART + RLENGTH); q = substr(q, 1, RSTART) }
      ch = ""
      if (rest != "") { gsub(/[❯›>]/, "", rest); while (match(rest, /[0-9]\. *[^0-9]+/)) { o = substr(rest, RSTART, RLENGTH); rest = substr(rest, RSTART + RLENGTH); gsub(/\. +/, " ", o); gsub(/ +$/, "", o); ch = ch (ch == "" ? "" : " · ") o } }
      for (i = qi + 1; i <= n && i <= qi + 6; i++) {
        o = l[i]; sub(/^(❯|›|>) */, "", o)
        if (o ~ /^[0-9]\. /) {
          sub(/\. +/, " ", o)
          if (o ~ /ask again|always/) { sub(/ .*/, " Yes, always", o) } else { sub(/,? and .*/, "", o); sub(/ \(.*/, "", o) }
          if (length(o) > 18) o = substr(o, 1, 17) "…"
          ch = ch (ch == "" ? "" : " · ") o
        }
      }
      cmd = ""
      for (i = qi - 1; i > 0 && i >= qi - 12; i--) {
        if (l[i] ~ /^\$ /) { cmd = substr(l[i], 3); break }
        if (match(l[i], /(Bash|Run|Shell)\(.*\)/)) { cmd = substr(l[i], RSTART, RLENGTH); sub(/^[A-Za-z]+\(/, "", cmd); sub(/\)$/, "", cmd); break }
        if (l[i] ~ /^(Bash command|Run command|Command)$/ && i + 1 < qi) { cmd = l[i + 1]; break }
      }
      if (cmd != "" && q ~ /^(Do you want to proceed|Allow command|Would you like to run|Do you want to run|Run this command)/) q = "Allow " cmd "?"
      gsub(/\t/, " ", q)
      if (length(q) > 100) q = substr(q, 1, 99) "…"
      printf "%s\t%s\n", q, ch
    }'
}
cmd__question() {
  pane=$1 since=$2
  [ "$(tmux display -p -t "$pane" '#{@pitwall_state} #{@pitwall_since}' 2>/dev/null)" = "asking $since" ] || return 0
  out=$(tmux capture-pane -p -J -t "$pane" -S -60 2>/dev/null | question_of)
  [ -n "$out" ] || return 0
  q=${out%%"$TAB"*} ch=${out#*"$TAB"}
  tmux set -p -t "$pane" @pitwall_question "$q" \; set -p -t "$pane" @pitwall_choices "$ch" 2>/dev/null
  [ "$(tmux show -gqv @pitwall-toast)" = off ] && return 0
  win=$(tmux display -p -t "$pane" '#{window_id}') name=$(tmux display -p -t "$pane" '#{window_name}#{?#{>:#{window_panes},1},.#{pane_index},}')
  viewers=$(tmux list-clients -f "#{==:#{window_id},$win}" -F '#{client_name}' 2>/dev/null)
  for c in $(tmux list-clients -F '#{client_name}' 2>/dev/null); do
    case " $(echo $viewers) " in *" $c "*) ;; *) tmux display-message -c "$c" -d 4000 "◆ $name: $q" 2>/dev/null ;; esac
  done
  return 0
}

cmd__escalate() {
  pane=$1 since=$2
  [ "$(tmux display -p -t "$pane" '#{@pitwall_state} #{@pitwall_since}' 2>/dev/null)" = "asking $since" ] || return 0
  name=$(tmux display -p -t "$pane" '#{window_name}#{?#{>:#{window_panes},1},.#{pane_index},}')
  mins=$((($(date +%s) - since) / 60))
  tmux set -p -t "$pane" @pitwall_urgent 1
  for c in $(tmux list-clients -F '#{client_name}'); do tmux refresh-client -S -t "$c" \; display-message -c "$c" -d 4000 "◆ $name has waited ${mins}m"; done
  [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/pitwall/opentimeline" ] && "$DIR/bin/pitwall-signal" "$pane" "${mins}m" asking urgent
  return 0
}

# --- save and restore --------------------------------------------------------------------------------------

# Saved lanes, newest record per pane position, as: harness sid cwd session window-index window pane server updated.
records() {
  [ -d "$STATE/lanes" ] || return 0
  find "$STATE/lanes" -type f -mtime +14 -delete 2>/dev/null # two weeks is long enough to come back for
  cat "$STATE/lanes"/* 2>/dev/null | awk 'NF' | sort -t "$TAB" -k9,9nr |
    awk -F '\t' '!seen[$4 FS $5 FS $7]++' | sort -t "$TAB" -k4,4 -k5,5n -k7,7n
}

server_pid() { tmux display -p '#{pid}' 2>/dev/null || echo none; }

# A record is restorable when its tmux server is gone. On the same server, a lane without its agent was closed
# on purpose, so it stays closed unless you ask with --all.
cmd_saved() {
  server=$(server_pid)
  running=$(tmux list-panes -a -F '#{@pitwall_session}' 2>/dev/null || true)
  now=$(date +%s)
  records | while IFS="$TAB" read -r harness sid cwd sname widx wname pidx rserver updated; do
    if printf '%s\n' "$running" | grep -qx "$sid"; then status=running
    elif [ "$rserver" = "$server" ]; then status=closed
    else status=restorable; fi
    printf '%-10s %-24s %-7s %5s  %s  %s\n' "$status" "$sname:$widx.$pidx $wname" "$harness" \
      "$(awk -v d=$((now - updated)) 'BEGIN { print (d < 3600 ? int(d / 60) "m" : d < 86400 ? int(d / 3600) "h" : int(d / 86400) "d") }')" \
      "$(printf %.8s "$sid")" "$(printf '%s' "$cwd" | sed "s|^$HOME|~|")"
  done
}

resume_cmd() { # resume_cmd <harness> <sid>
  tpl=$(tmux show -gqv "@pitwall-resume-$1" 2>/dev/null)
  case $1 in
    claude) tpl=${tpl:-claude --resume \{id\}} ;;
    codex) tpl=${tpl:-codex resume \{id\}} ;;
    hermes) tpl=${tpl:-hermes --resume \{id\}} ;;
    grok) tpl=${tpl:-grok --resume \{id\}} ;;
    opencode) tpl=${tpl:-opencode --session \{id\}} ;;
    pi) tpl=${tpl:-pi --session \{id\}} ;;
    *) [ -n "$tpl" ] || return 1 ;; # any other agent, once @pitwall-resume-<agent> says how
  esac
  printf '%s' "$tpl" | sed "s/{id}/$2/g"
}

is_shell() { case $1 in zsh | -zsh | bash | -bash | fish | sh | -sh | login) return 0 ;; *) return 1 ;; esac; }

cmd_restore() {
  mode=${1:-}
  server=$(server_pid)
  running=$(tmux list-panes -a -F '#{@pitwall_session}' 2>/dev/null || true)
  plan=$(records | while IFS="$TAB" read -r harness sid cwd sname widx wname pidx rserver updated; do
    printf '%s\n' "$running" | grep -qx "$sid" && continue
    [ "$rserver" = "$server" ] && [ "$mode" != --all ] && continue
    printf '%s\n' "$harness$TAB$sid$TAB$cwd$TAB$sname$TAB$widx$TAB$wname$TAB$pidx"
  done)
  count=$(printf '%s' "$plan" | awk 'NF' | wc -l | tr -d ' ')
  if [ "$mode" = --count ]; then echo "$count"; return; fi
  if [ "$count" = 0 ]; then echo "pitwall: nothing to restore"; return; fi

  used=''
  printf '%s\n' "$plan" | while IFS="$TAB" read -r harness sid cwd sname widx wname pidx; do
    cmd=$(resume_cmd "$harness" "$sid") || { echo "skip  $sname:$widx $wname: unknown agent $harness"; continue; }
    echo "$( [ "$mode" = --dry ] && echo would || echo open)  $sname:$widx $wname ($harness) in $(printf '%s' "$cwd" | sed "s|^$HOME|~|")"
    [ "$mode" = --dry ] && continue
    [ -d "$cwd" ] || cwd=$HOME
    if ! tmux has-session -t "=$sname" 2>/dev/null; then
      pane=$(tmux new-session -d -P -F '#{pane_id}' -s "$sname" -n "$wname" -c "$cwd")
      [ "$(tmux display -p -t "$pane" '#{window_index}')" = "$widx" ] || tmux move-window -s "$pane" -t "=$sname:$widx" 2>/dev/null || true
    elif ! tmux list-windows -t "=$sname" -F '#{window_index}' | grep -qx "$widx"; then
      pane=$(tmux new-window -d -P -F '#{pane_id}' -t "=$sname:$widx" -n "$wname" -c "$cwd")
    else
      first=$(tmux display -p -t "=$sname:$widx.0" '#{pane_id} #{pane_current_command}' 2>/dev/null ||
        tmux list-panes -t "=$sname:$widx" -F '#{pane_id} #{pane_current_command}' | head -1)
      case " $used " in *" $sname:$widx "*) first='' ;; esac
      if [ -n "$first" ] && is_shell "${first#* }"; then pane=${first%% *}
      else
        pane=$(tmux split-window -d -P -F '#{pane_id}' -t "=$sname:$widx" -c "$cwd")
        tmux select-layout -t "=$sname:$widx" tiled >/dev/null
      fi
    fi
    used="$used $sname:$widx"
    tmux set -p -t "$pane" @pitwall_session "$sid" \; send-keys -t "$pane" "cd '$(printf '%s' "$cwd" | sed "s/'/'\\\\''/g")' && $cmd" Enter
    # The record now points at this server, so restoring again does not open it twice.
    f="$STATE/lanes/$sid"
    if [ -f "$f" ]; then awk -F '\t' -v OFS='\t' -v s="$(server_pid)" '{ $8 = s; print }' "$f" >"$f.tmp" && mv -f "$f.tmp" "$f"; fi
  done
  [ "$mode" = --dry ] || { tmux set -g @pitwall_restorable 0 2>/dev/null; echo "attach with: tmux attach"; }
}

# The popup behind prefix R: the plan, then one key to go.
cmd_restore_prompt() {
  plan=$(cmd_restore --dry)
  printf '\n  \033[1mpitwall\033[0m · restore\n\n%s\n\n' "$(printf '%s\n' "$plan" | sed 's/^/  /')"
  case $plan in "pitwall: nothing to restore") sleep 1.5; return ;; esac
  printf '  \033[38;2;245;158;11mi\033[0m or ⏎ restore   \033[38;2;156;163;175mh q\033[0m cancel '
  stty -icanon -echo 2>/dev/null; k=$(dd bs=1 count=1 2>/dev/null); stty icanon echo 2>/dev/null
  case $k in i | '' | "$(printf '\n')" | "$(printf '\r')") printf '\n\n'; cmd_restore | sed 's/^/  /'; sleep 1.5 ;; esac
}

cmd_forget() {
  [ -n "${1:-}" ] || { echo "usage: pitwall forget <session id or its first characters>" >&2; exit 1; }
  n=$(find "$STATE/lanes" -type f -name "$1*" 2>/dev/null | wc -l | tr -d ' ')
  find "$STATE/lanes" -type f -name "$1*" -delete 2>/dev/null
  echo "forgot $n saved lane(s)"
}

# --- worktrees ---------------------------------------------------------------------------------------------

# new <name>: gwm makes the worktree inside the current pane's repository; the agent starts in a new window there.
# The commands run in that window's own shell, so any prompt from gwm or the agent is yours to answer.
cmd_new() {
  name=${1:?usage: pitwall new <name> [--agent claude|codex]}
  agent=$(tmux show -gqv @pitwall-agent 2>/dev/null)
  agent=${agent:-claude}
  [ "${2:-}" = --agent ] && agent=${3:?usage: pitwall new <name> --agent claude|codex}
  command -v gwm >/dev/null || { echo "pitwall: gwm is not installed (https://github.com/kbrdn1/gwm)" >&2; exit 1; }
  repo=$(tmux display -p '#{pane_current_path}')
  pane=$(tmux new-window -P -F '#{pane_id}' -n "$name" -c "$repo")
  tmux send-keys -t "$pane" "gwm create --name '$name' && cd \"\$(gwm path '$name')\" && $agent" Enter
}

# done @N: review the lane's diff in lumen, then, only on an explicit y, close the window and remove the worktree.
cmd_done() {
  id=$(resolve "${1:?usage: pitwall done @N}")
  tmux display-popup -E -w 90% -h 90% -d "$(tmux display -p -t "$id" '#{pane_current_path}')" "'$DIR/bin/pitwall' _done '$id'"
}

cmd__done() {
  id=$1
  path=$(pwd)
  command -v lumen >/dev/null && lumen diff || git -c color.ui=always diff | less -R
  printf '\n  Remove the worktree %s and close its window? [y/N] ' "${path##*/}"
  read -r answer
  case $answer in
    y | Y)
      win=$(tmux display -p -t "$id" '#{window_id}')
      cd "$HOME" && gwm remove "${path##*/}" && tmux kill-window -t "$win"
      ;;
    *) echo "  Kept." && sleep 0.6 ;;
  esac
}

EVENTS='SessionStart UserPromptSubmit PreToolUse PostToolUse PermissionRequest Notification Stop SessionEnd'

cmd_install() {
  # Same JSON shape for both harnesses: { "hooks": { Event: [ { "hooks": [ {type, command} ] } ] } }.
  write=${1:-}
  for target in claude:"$HOME/.claude/settings.json" codex:"$HOME/.codex/hooks.json"; do
    harness=${target%%:*}
    file=${target#*:}
    python3 -I - "$file" "$HOOK" "$harness" "$write" "$EVENTS" <<'EOF'
import json, os, shutil, sys
path, hook, harness, write, events = sys.argv[1:]
data = {}
if os.path.exists(path):
    with open(path) as f:
        data = json.load(f)
hooks = data.setdefault("hooks", {})
added = []
for event in events.split():
    if harness == "codex" and event in ("Notification", "SessionEnd"):
        continue  # Codex has no such events; PermissionRequest and Stop cover it
    command = f"'{hook}' {event} {harness}"
    groups = hooks.setdefault(event, [])
    if any("pitwall-hook" in h.get("command", "") for g in groups for h in g.get("hooks", [])):
        continue
    groups.append({"hooks": [{"type": "command", "command": command, "timeout": 2}]})
    added.append(event)
if not added:
    print(f"{harness}: hooks already installed in {path}")
elif write == "--write":
    if os.path.exists(path):
        shutil.copy2(path, path + ".bak-pitwall")
    with open(path + ".tmp", "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.replace(path + ".tmp", path)
    print(f"{harness}: added {', '.join(added)} to {path} (backup: {path}.bak-pitwall)")
else:
    print(f"{harness}: would add {', '.join(added)} to {path}, each running:")
    print(f"  '{hook}' <Event> {harness}")
EOF
  done
  install_hermes "$write"
  install_skill "$write"
  [ "$write" = --write ] || echo "run 'pitwall install --write' to add them; restart the agents to pick them up"
}

# Hermes keeps its hooks in YAML next to the rest of its config, with comments worth keeping: the block is
# appended as text, never rewritten. A config that already has a hooks: block gets the lines to paste instead.
# Hermes events, mapped onto the hook's: a turn starts (pre_llm_call, once per turn), each tool call (post_tool_call)
# keeps it working, waits on a person (approval, a question, sudo), resumes, ends (on_session_end fires once per
# turn), and a session closes (on_session_finalize, also when Hermes reaps one it left behind: the hook then checks
# the agent really exited).
HERMES_EVENTS='on_session_open:SessionStart pre_llm_call:UserPromptSubmit post_tool_call:PostToolUse on_human_input_request:PermissionRequest on_human_input_resolved:PostToolUse on_session_end:Stop on_session_finalize:SessionEnd'
install_hermes() {
  file=${HERMES_HOME:-$HOME/.hermes}/config.yaml
  [ -f "$file" ] || return 0 # no Hermes here
  if grep -q pitwall-hook "$file"; then
    # An older install: events added since go at the end, when pitwall's block is still the last thing in the file.
    missing=''
    for m in $HERMES_EVENTS; do grep -q "pitwall-hook ${m#*:} hermes" "$file" && grep -q "^  ${m%%:*}:" "$file" || missing="$missing $m"; done
    [ -n "$missing" ] || { echo "hermes: hooks already installed in $file"; return 0; }
    lines=''
    for m in $missing; do lines="$lines
  ${m%%:*}:
    - command: $HOOK ${m#*:} hermes
      timeout: 5"; done
    if [ "${1:-}" = --write ] && awk '/^# pitwall: lane states in tmux/ { p = 1; next } p && /^hooks:/ { next } p && /^[^ #]/ { bad = 1 } END { exit !(p && !bad) }' "$file"; then
      cp -p "$file" "$file.bak-pitwall" && printf '%s\n' "${lines#?}" >>"$file"
      echo "hermes: added$(for m in $missing; do printf ' %s' "${m%%:*}"; done) to $file (backup: $file.bak-pitwall); Hermes asks you to approve each new hook once"
    else
      echo "hermes: add these under hooks: in $file:"; printf '%s\n' "${lines#?}"
    fi
    return 0
  fi
  block="# pitwall: lane states in tmux (pitwall install)
hooks:"
  for m in $HERMES_EVENTS; do
    block="$block
  ${m%%:*}:
    - command: $HOOK ${m#*:} hermes
      timeout: 5"
  done
  if grep -q '^hooks:' "$file"; then
    echo "hermes: $file already has a hooks: block; add these under it:"
    printf '%s\n' "$block" | sed '1,2d'
  elif [ "${1:-}" = --write ]; then
    cp -p "$file" "$file.bak-pitwall" && printf '\n%s\n' "$block" >>"$file"
    echo "hermes: added ${HERMES_EVENTS%% *}… to $file (backup: $file.bak-pitwall); Hermes asks you to approve each hook once"
  else
    echo "hermes: would append to $file:"
    printf '%s\n' "$block" | sed 's/^/  /'
  fi
}

# --- workspaces from a file: pitwall up -----------------------------------------------------------------------

# A recipe is a small TOML file: top-level workspace (and name, dir), then [[tab]] tables (name, dir, agent, run,
# worktree, fresh), [[tab.pane]] for more panes in the last tab, [[include]] for another project's recipe. It lives
# in a repo (.pitwall.toml) or in ~/.config/pitwall/up/<name>.toml. Read here, in awk: no TOML library needed.
UPDIR=${XDG_CONFIG_HOME:-$HOME/.config}/pitwall/up

up_parse() { # up_parse <file> → rows: T name dir agent run worktree fresh session · P agent run session · I path · W name workspace dir
  awk '
    function val(s,   out, c) {
      sub(/^[ \t]*/, "", s)
      if (substr(s, 1, 1) != "\"") { sub(/[ \t]*#.*$/, "", s); sub(/[ \t]*$/, "", s); return s }
      s = substr(s, 2); out = ""
      while (length(s)) {
        c = substr(s, 1, 1)
        if (c == "\\") { out = out substr(s, 2, 1); s = substr(s, 3); continue }
        if (c == "\"") break
        out = out c; s = substr(s, 2)
      }
      return out
    }
    function flush() {
      if (sec == "tab") printf "T\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", t["name"], t["dir"], t["agent"], t["run"], t["worktree"], t["fresh"], t["session"]
      else if (sec == "pane") printf "P\t%s\t%s\t%s\n", t["agent"], t["run"], t["session"]
      else if (sec == "include") printf "I\t%s\n", t["path"]
      split("", t)
    }
    { line = $0 }
    line ~ /^[ \t]*(#|$)/ { next }
    line ~ /^[ \t]*\[\[/ {
      flush()
      h = line; sub(/^[ \t]*\[\[[ \t]*/, "", h); name = h; sub(/[ \t]*\]\].*$/, "", name)
      sec = (name == "tab" ? "tab" : name == "tab.pane" ? "pane" : name == "include" ? "include" : "other")
      if (sec == "pane") { printf "%s", "" }
      line = h; sub(/^[^\]]*\]\][ \t]*/, "", line) # a key may follow on the same line
      if (line == "" || line ~ /^#/) next
    }
    match(line, /^[ \t]*[A-Za-z_]+[ \t]*=/) {
      k = substr(line, RSTART, RLENGTH); sub(/[ \t]*=$/, "", k); sub(/^[ \t]*/, "", k)
      v = val(substr(line, RSTART + RLENGTH))
      if (sec == "") top[k] = v; else t[k] = v
    }
    END { flush(); printf "W\t%s\t%s\t%s\n", top["name"], top["workspace"], top["dir"] }
  ' "$1"
}

up_find() { # up_find [name | file | folder] → the recipe's path
  a=${1:-}
  if [ -z "$a" ]; then
    for d in "$PWD" "$(git rev-parse --show-toplevel 2>/dev/null)"; do [ -n "$d" ] && [ -f "$d/.pitwall.toml" ] && { echo "$d/.pitwall.toml"; return; }; done
    return 1
  fi
  a=$(printf '%s' "$a" | sed "s|^~|$HOME|")
  [ -f "$a" ] && { (cd "$(dirname "$a")" && printf '%s/%s\n' "$(pwd)" "$(basename "$a")"); return; }
  [ -f "$a/.pitwall.toml" ] && { (cd "$a" && printf '%s/.pitwall.toml\n' "$(pwd)"); return; }
  [ -f "$UPDIR/$a.toml" ] && { echo "$UPDIR/$a.toml"; return; }
  [ -f "$UPDIR/$a.link" ] && [ -f "$(cat "$UPDIR/$a.link")" ] && { cat "$UPDIR/$a.link"; return; }
  return 1
}

up_name() { # up_name <file>: its name = top-level name, else the folder of a repo's .pitwall.toml, else the file's name
  n=$(up_parse "$1" | awk -F '\t' '$1 == "W" { print $2 }')
  [ -n "$n" ] && { echo "$n"; return; }
  case $1 in */.pitwall.toml) basename "$(dirname "$1")" ;; *) basename "$1" .toml ;; esac
}

# A recipe from a repo runs commands: the first time (and after it changes) it asks, once. Yours, in ~/.config, never.
up_trust() { # up_trust <file> [--yes]
  case $1 in "$UPDIR"/*) return 0 ;; esac
  sum=$( (shasum -a 256 "$1" 2>/dev/null || sha256sum "$1") | cut -c1-64)
  [ -f "$STATE/up-trusted" ] && grep -qx "$sum $1" "$STATE/up-trusted" && return 0
  if [ "${2:-}" != --yes ]; then
    { : </dev/tty; } 2>/dev/null || { echo "pitwall up: $1 is new or changed; run it once from a terminal, or with --yes" >&2; return 1; }
    printf 'run what %s says? [y/N] ' "$1" >/dev/tty; read -r ok </dev/tty
    case $ok in y | Y | yes) ;; *) return 1 ;; esac
  fi
  mkdir -p "$STATE" && grep -v " $1\$" "$STATE/up-trusted" 2>/dev/null >"$STATE/up-trusted.new"; echo "$sum $1" >>"$STATE/up-trusted.new"
  mv -f "$STATE/up-trusted.new" "$STATE/up-trusted"
}

up_agent() { # up_agent <agent> <dir> <fresh> [session] → the command that starts it: that session (saved by --save),
  # else its last one in that folder, resumed; a new one with fresh = true or when there is none
  [ "$3" = true ] && { echo "$1"; return; }
  [ -n "${4:-}" ] && resume_cmd "$1" "$4" && return
  phys=$(cd "$2" 2>/dev/null && pwd -P || echo "$2")
  running=$(tmux list-panes -a -F '#{@pitwall_session}' 2>/dev/null || true)
  sid=$(records | awk -F '\t' -v h="$1" -v d="$2" -v p="$phys" '$1 == h && ($3 == d || $3 == p) { print $9 "\t" $2 }' | sort -rn | cut -f2 |
    while read -r s; do printf '%s\n' "$running" | grep -qx "$s" || { echo "$s"; break; }; done)
  [ -n "$sid" ] && resume_cmd "$1" "$sid" && return
  echo "$1"
}

up_run() { # up_run <file> <dry> [workspace]: bring the recipe up; what is there stays, what is missing comes back
  file=$1 dry=$2 base=$(cd "$(dirname "$1")" && pwd)
  rows=$(up_parse "$file")
  w=$(printf '%s\n' "$rows" | awk -F '\t' '$1 == "W"')
  ws=${3:-$(printf '%s' "$w" | cut -f3)}
  [ -n "$ws" ] || ws=$(up_name "$file")
  wsdir=$(printf '%s' "$w" | cut -f4 | sed "s|^~|$HOME|")
  case $wsdir in '') wsdir=$base ;; /*) ;; *) wsdir=$base/$wsdir ;; esac
  spare=''
  if ! tmux has-session -t "=$ws" 2>/dev/null; then
    if [ -n "$dry" ]; then echo "+ $ws  would make the workspace"
    else spare=$(tmux new-session -d -P -F '#{window_id}' -s "$ws" -c "$wsdir") && printf '✓ %-12s workspace made\n' "$ws"; fi
  fi
  skip='' pane=''
  printf '%s\n' "$rows" | tr '\t' '\037' | while IFS=$(printf '\037') read -r kind a b c d e f g; do
    case $kind in
      T)
        name=$a skip='' pane=''
        tdir=$(printf '%s' "$b" | sed "s|^~|$HOME|"); case $tdir in '') tdir=$wsdir ;; /*) ;; *) tdir=$wsdir/$tdir ;; esac # relative to the workspace's folder
        [ -n "$name" ] || name=$(basename "$tdir")
        if tmux list-windows -t "=$ws" -F '#{window_name}' 2>/dev/null | grep -qxF -- "$name"; then
          st=$(tmux list-panes -t "=$ws:$name" -F '#{@pitwall_state}' 2>/dev/null | grep . | head -1)
          printf '· %-12s already up%s\n' "$name" "${st:+ ($st)}"; skip=1; continue
        fi
        what=''
        if [ -n "$e" ]; then
          if [ -n "$dry" ]; then what="worktree $e, "
          elif command -v gwm >/dev/null; then
            p=$(cd "$tdir" && gwm path "$e" 2>/dev/null)
            [ -n "$p" ] || { (cd "$tdir" && gwm create --name "$e" >/dev/null 2>&1); p=$(cd "$tdir" && gwm path "$e" 2>/dev/null); what="worktree $e (made), "; }
            [ -n "$p" ] && tdir=$p && what=${what:-"worktree $e, "}
          else what="no gwm for worktree $e, "; fi
        fi
        if [ -n "$c" ]; then cmd=$(up_agent "$c" "$tdir" "$f" "$g"); case $cmd in "$c") what="$what$c" ;; *) what="$what$c, resumed" ;; esac
        elif [ -n "$d" ]; then cmd=$d what="$what$d"
        else cmd='' what="${what}a shell"; fi
        if [ -n "$dry" ]; then printf '+ %-12s would open: %s\n' "$name" "$what"; continue; fi
        if [ -n "$spare" ]; then # the workspace's first window becomes the first tab
          tmux rename-window -t "$spare" "$name"; tmux respawn-pane -k -t "$spare" -c "$tdir"
          pane=$(tmux display -p -t "$spare" '#{pane_id}'); spare=''
        else
          pane=$(tmux new-window -d -P -F '#{pane_id}' -t "=$ws:" -n "$name" -c "$tdir")
        fi
        [ -n "$cmd" ] && tmux send-keys -t "$pane" "$cmd" Enter
        printf '✓ %-12s %s\n' "$name" "$what"
        ;;
      P)
        [ -n "$skip" ] && continue
        cmd=$b; [ -n "$a" ] && cmd=$(up_agent "$a" "$tdir" '' "$c")
        [ -n "$dry" ] && { printf '+ %-12s   and a pane: %s\n' "$name" "${a:-$b}"; continue; }
        [ -n "$pane" ] || continue
        p=$(tmux split-window -d -P -F '#{pane_id}' -t "$pane" -c "$tdir")
        [ -n "$cmd" ] && tmux send-keys -t "$p" "$cmd" Enter
        ;;
      I)
        inc=$(up_find "$a") || { echo "! include $a: no recipe there" >&2; continue; }
        up_trust "$inc" ${yes:-} || continue
        (up_run "$inc" "$dry" "$ws") # its own variables: the rest of this recipe keeps its own
        ;;
    esac
  done
}

up_list() { # up_list [--plain]: the recipes it knows, and how much of each is up
  for f in "$UPDIR"/*.toml "$UPDIR"/*.link; do
    [ -f "$f" ] || continue
    case $f in *.link) r=$(cat "$f"); [ -f "$r" ] || continue ;; *) r=$f ;; esac
    rows=$(up_parse "$r") name=$(up_name "$r")
    ws=$(printf '%s\n' "$rows" | awk -F '\t' '$1 == "W" { print $3 }'); ws=${ws:-$name}
    tabs=$(printf '%s\n' "$rows" | awk -F '\t' '$1 == "T" { print $2 }')
    n=$(printf '%s\n' "$tabs" | grep -c .) up=0
    have=$(tmux list-windows -t "=$ws" -F '#{window_name}' 2>/dev/null || true)
    for t in $tabs; do printf '%s\n' "$have" | grep -qxF -- "$t" && up=$((up + 1)); done
    if [ "${1:-}" = --plain ]; then printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$ws" "$n" "$up" "$r"
    else
      if [ "$up" = "$n" ] && [ "$n" -gt 0 ]; then s=up; elif [ "$up" = 0 ]; then s=down; else s="$up of $n up"; fi
      printf '%-18s %-10s %2s tabs  %-10s %s\n' "$name" "$ws" "$n" "$s" "$(printf '%s' "$r" | sed "s|^$HOME|~|")"
    fi
  done
}

# A recipe saved with --save is kept current: tabs opened, closed or renamed, and agents starting new sessions, write
# it again (in the background, from tmux's hooks and pitwall's). Edit it by hand and it is yours: never written again.
sum_of() { (shasum -a 256 "$1" 2>/dev/null || sha256sum "$1") | cut -c1-64; }

up_save() { # up_save [workspace] [--auto]: a recipe from a workspace that is open: each tab's folder, agent or command
  ws=${1:-$(tmux display -p '#{session_name}' 2>/dev/null)} auto=${2:-}
  if ! tmux has-session -t "=$ws" 2>/dev/null; then [ -n "$auto" ] && return 0; echo "pitwall up --save: no workspace $ws" >&2; exit 1; fi
  mkdir -p "$UPDIR" "$STATE/up-saved"; out=$UPDIR/$ws.toml new=$UPDIR/.$ws.toml.$$ sumf=$STATE/up-saved/$ws
  if [ -n "$auto" ]; then
    [ -f "$out" ] || return 0 # only a workspace you saved once
    if [ -f "$sumf" ]; then [ "$(cat "$sumf")" = "$(sum_of "$out")" ] || return 0 # edited by hand since: yours now
    else head -1 "$out" | grep -q '^# pitwall up .*: saved from the open workspace' || return 0; fi
  fi
  q() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }
  what_runs() { # what_runs <pane-pid> <current-command> <harness> [session]: agent=… (and its session) or run=…
    if [ -n "$3" ]; then echo "agent = $(q "$3")"; [ -n "${4:-}" ] && echo "session = $(q "$4")"; return; fi
    if is_shell "$2"; then # a bare shell is left out, unless it is a `sh -c "cmd"` wrapper (dash keeps itself around)
      case $(ps -o args= -p "$1" 2>/dev/null) in *" -c "*) set -- "$1" "$(ps -o comm= -p "$(pgrep -P "$1" | head -1)" 2>/dev/null | sed 's|.*/||')" ;; *) return 0 ;; esac
    fi
    c=$(pgrep -P "$1" -x "$2" 2>/dev/null | head -1 || true) # the child the pane reports, not a prompt's helper
    [ -n "$c" ] || c=$(pgrep -P "$1" 2>/dev/null | head -1 || true)
    args=$(ps -o args= -p "${c:-$1}" 2>/dev/null || true) # no child: the pane runs the command itself
    case $args in node\ */pnpm* | node\ */npm* | node\ */npx* | node\ */yarn*) args=$(printf '%s' "$args" | sed 's|^node [^ ]*/||') ;; esac
    [ -z "$args" ] || echo "run = $(q "$args")"
  }
  {
    printf '# pitwall up %s: saved from the open workspace and kept current; edit it and it stays as you leave it\nworkspace = %s\n' "$ws" "$(q "$ws")"
    tmux list-windows -t "=$ws" -F '#{window_id}' | while read -r win; do
      first=1
      # "-" for an empty harness: read merges consecutive tabs (and tmux 3.4 escapes a \037 separator)
      tmux list-panes -t "$win" -F "#{pane_pid}$TAB#{pane_current_command}$TAB#{?#{@pitwall_harness},#{@pitwall_harness},-}$TAB#{?#{@pitwall_session},#{@pitwall_session},-}$TAB#{pane_current_path}$TAB#{window_name}" |
        while IFS=$TAB read -r pid cmd harness sid dir wname; do
          [ "$harness" = - ] && harness=''
          [ "$sid" = - ] && sid=''
          r=$(what_runs "$pid" "$cmd" "$harness" "$sid")
          if [ -n "$first" ]; then
            [ -n "$r" ] || break # a window whose first pane is a bare shell is left out
            printf '\n[[tab]]\nname = %s\ndir = %s\n%s\n' "$(q "$wname")" "$(q "$(printf '%s' "$dir" | sed "s|^$HOME|~|")")" "$r"
            first=''
          elif [ -n "$r" ]; then printf '[[tab.pane]]\n%s\n' "$r"; fi
        done
    done
  } >"$new"
  n=$(grep -c '^\[\[tab\]\]' "$new")
  if [ -n "$auto" ]; then # quietly, and never down to nothing (a workspace closing tab by tab)
    if [ "$n" -gt 0 ] && ! cmp -s "$new" "$out"; then mv -f "$new" "$out" && sum_of "$out" >"$sumf"; else rm -f "$new"; fi
    return 0
  fi
  [ -f "$out" ] && ! cmp -s "$new" "$out" && cp -p "$out" "$out.bak"
  mv -f "$new" "$out" && sum_of "$out" >"$sumf"
  echo "✓ wrote $(printf '%s' "$out" | sed "s|^$HOME|~|") from the $ws workspace: $n tab$( [ "$n" = 1 ] || echo s), kept current from now on"
}

cmd__autosave() { # _autosave <workspace>: from tmux's hooks; a moment later, so a burst of changes writes once
  [ "$(tmux show -gqv @pitwall-up-autosave)" = off ] && return 0
  [ -f "$UPDIR/$1.toml" ] || return 0
  mkdir -p "$STATE/up-saved"; echo $$ >"$STATE/up-saved/$1.pending"
  sleep 2
  [ "$(cat "$STATE/up-saved/$1.pending" 2>/dev/null)" = $$ ] || return 0 # a later change in the burst saves instead
  up_save "$1" --auto
  return 0
}

cmd_up() {
  dry='' yes=''
  while :; do
    case ${1:-} in
      --list) shift; up_list "$@"; return ;;
      --save) shift; up_save "${1:-}"; return ;;
      --dry) dry=1; shift ;;
      --yes) yes=--yes; shift ;;
      *) break ;;
    esac
  done
  file=$(up_find "${1:-}") || { echo "pitwall up: no recipe ${1:+for $1 }(a .pitwall.toml here, or $(printf '%s' "$UPDIR" | sed "s|^$HOME|~|")/<name>.toml)" >&2; exit 1; }
  up_trust "$file" $yes || exit 1
  case $file in "$UPDIR"/*) ;; *) mkdir -p "$UPDIR" && n=$(up_name "$file") && [ ! -f "$UPDIR/$n.toml" ] && echo "$file" >"$UPDIR/$n.link" ;; esac # --list knows it next time
  up_run "$file" "$dry"
}

# The skill (skills/pitwall/SKILL.md) teaches agents to read the lanes and to ask before acting on one: linked into
# each agent's skills folder that exists, so it follows pitwall's updates. Something else already there stays.
install_skill() {
  for d in "$HOME/.claude/skills" "$HOME/.codex/skills" "${HERMES_HOME:-$HOME/.hermes}/skills" "$HOME/.agents/skills"; do
    [ -d "$d" ] || continue
    t=$d/pitwall
    if [ -L "$t" ] && [ "$(readlink "$t")" = "$DIR/skills/pitwall" ]; then echo "skill: already in $t"
    elif [ -e "$t" ]; then echo "skill: $t exists and is not pitwall's; left alone"
    elif [ "${1:-}" = --write ]; then ln -s "$DIR/skills/pitwall" "$t" && echo "skill: linked into $t"
    else echo "skill: would link into $t"; fi
  done
}

cmd_doctor() {
  ok=0
  check() { if eval "$2"; then echo "ok    $1"; else echo "MISS  $1${3:+ → $3}"; ok=1; fi; }
  check "tmux 3.2 or newer" '[ "$(tmux -V | tr -dc 0-9. | cut -d. -f1)" -ge 3 ]'
  check "inside tmux" '[ -n "${TMUX:-}" ]'
  check "pitwall loaded in this server" '[ -n "$(tmux show -gqv @pitwall-state-fmt 2>/dev/null)" ]' "run-shell $DIR/pitwall.tmux"
  check "Claude Code hooks" 'grep -q pitwall-hook "$HOME/.claude/settings.json" 2>/dev/null' "pitwall install --write"
  check "Codex hooks" 'grep -q pitwall-hook "$HOME/.codex/hooks.json" 2>/dev/null' "pitwall install --write"
  [ -f "${HERMES_HOME:-$HOME/.hermes}/config.yaml" ] &&
    check "Hermes hooks, tool calls included" 'grep -q "pitwall-hook PostToolUse hermes" "${HERMES_HOME:-$HOME/.hermes}/config.yaml" && grep -q "^  post_tool_call:" "${HERMES_HOME:-$HOME/.hermes}/config.yaml"' "pitwall install --write"
  [ -d "$HOME/.claude/skills" ] && check "the pitwall skill for agents" '[ -e "$HOME/.claude/skills/pitwall/SKILL.md" ]' "pitwall install --write"
  check "python3 (only for install)" 'command -v python3 >/dev/null'
  return $ok
}

cmd_demo() {
  T="tmux -L pitwall-demo"
  if [ "${1:-}" = stop ]; then $T kill-server 2>/dev/null; echo "demo stopped"; return; fi
  $T kill-server 2>/dev/null || true
  # A blank server styled like the mateonunez.co theme: none of your config, plugins or shell prompt runs here.
  $T -f /dev/null start-server \; set -g base-index 1 \; set -g pane-base-index 1 \; set -g allow-set-title off \
    \; set -g default-command "env PS1='❯ ' /bin/sh" \
    \; set-environment -g XDG_STATE_HOME "${TMPDIR:-/tmp}/pitwall-demo-state" \
    \; new-session -d -s lab -n opentimeline -x 160 -y 40
  $T set -g prefix2 C-a \; set -g mouse on \; set -g status-interval 2 \
    \; set -g status-style 'bg=#0a0a0a,fg=#6b7280' \; set -g window-style 'bg=#0a0a0a' \
    \; set -g pane-border-style 'fg=#262626' \; set -g pane-active-border-style 'fg=#f59e0b' \
    \; set -g allow-rename off \; set -g automatic-rename off \
    \; set -g @pitwall-layout tabs \; set -g @pitwall-system on \; set -g @pitwall-quota off \
    \; set -g @pitwall_quota '#[fg=#6b7280]claude 5h #[fg=#9ca3af]12%#[fg=#6b7280] ↻3h · wk #[fg=#9ca3af]34%#[fg=#6b7280] ↻5d   codex wk #[fg=#9ca3af]41%#[fg=#6b7280] ↻2d' \
    \; set -g @pitwall_quota_plain 'claude 5h 12% ↻3h · wk 34% ↻5d   codex wk 41% ↻2d' 
  pane() { # target state harness age-in-seconds task
    $T set -p -t "$1" @pitwall_state "$2" \; set -p -t "$1" @pitwall_harness "$3" \
      \; set -p -t "$1" @pitwall_since "$(($(date +%s) - $4))" \; select-pane -t "$1" -T "$5"
  }
  lane() { # window state harness age-in-seconds task, then what the pane shows
    $T list-windows -t lab -F '#W' | grep -qx "$1" || $T new-window -t lab -n "$1"
    pane "lab:$1" "$2" "$3" "$4" "$5"
    show "lab:$1" "$6"
  }
  show() { $T respawn-pane -k -t "$1" "printf '$2'; exec sleep 86400"; } # what the lane shows, no command echoed
  lane opentimeline asking codex 180 "Cut the 0.2.0 release" \
    '\n  • Ran pnpm test\n    └ 512 passing\n\n  $ pnpm release --tag v0.2.0\n\n  Allow command?  › 1. Yes   2. Yes, always   3. No\n'
  lane website done claude 720 "Add the Spotify now-playing card" \
    '\n  ⏺ Update(app/components/now-playing.tsx)\n    ⎿  Added 42 lines\n\n  ⏺ The card renders the current track and falls back to the last played one.\n'
  lane ait working codex 2460 "Sync Linear issues into the RAG index" \
    '\n  • Explored\n    └ Read packages/connectors/linear/src/sync.ts\n\n  • Running pnpm --filter @ait/linear test\n'
  lane dotfiles idle claude 0 "Tabs for the tmux status line" \
    '\n  ⏺ Workspaces are tab groups on top; the limits and the machine sit on the bottom rule.\n'
  # Two agents in one window: each pane is its own lane, the window shows the more urgent one.
  p=$($T split-window -h -d -P -F '#{pane_id}' -t lab:ait)
  pane "$p" asking claude 60 "Review the Linear sync diff"
  show "$p" '\n  ⏺ Bash(pnpm --filter @ait/linear lint)\n\n  Do you want to proceed?\n  ❯ 1. Yes\n    2. No\n'
  $T new-window -t lab -n notes
  # A second workspace, so moving lanes and the workspace picker have somewhere to go.
  $T new-session -d -s oss -n malock -x 160 -y 40
  pane oss:malock asking codex 300 "Publish the 2.0 release notes"
  show oss:malock '\n  • Ran npm publish --dry-run\n\n  Allow command?  › 1. Yes   2. No\n'
  $T select-window -t lab:dotfiles
  $T run-shell "'$DIR/pitwall.tmux'"
  # The asking lanes' questions, read off their screens as the hook would have.
  sleep 0.5
  sock=$($T display -p '#{socket_path}')
  $T list-panes -a -F '#{pane_id} #{@pitwall_state} #{@pitwall_since}' | while read -r id st since; do
    [ "$st" = asking ] && TMUX="$sock,0,0" "$DIR/bin/pitwall" _question "$id" "$since"
  done
  # Lanes move on their own so you can watch: ait finishes in 15 s while you look elsewhere, then a new lane starts.
  $T run-shell -b "sleep 15; tmux set -p -t lab:ait.1 @pitwall_state done"
  $T run-shell -b "sleep 25; tmux rename-window -t lab:notes fastify-orama \; set -p -t lab:fastify-orama @pitwall_state working \; set -p -t lab:fastify-orama @pitwall_harness claude \; select-pane -t lab:fastify-orama -T 'Bump Orama to v3'; '$DIR/bin/pitwall-tick'"
  echo "attach:  tmux -L pitwall-demo attach -t lab"
  echo "keys:    prefix Space dashboard · prefix a next lane that needs you"
  echo "stop:    pitwall demo stop"
}

case ${1:-} in
  ls) shift; cmd_ls "${1:-}" ;;
  peek) shift; cmd_peek "$@" ;;
  go) shift; cmd_go "$@" ;;
  answer) shift; cmd_answer "$@" ;;
  send) shift; cmd_send "$@" ;;
  seen) shift; cmd_seen "$@" ;;
  next) shift; cmd_next "${1:-}" ;;
  dash | board) exec "$DIR/bin/pitwall-dash" ;;
  _lanes) lanes ;;
  stats) shift; cmd_stats "$@" ;;
  quota) shift; cmd_quota "${1:-}" ;;
  saved) cmd_saved ;;
  restore) shift; cmd_restore "${1:-}" ;;
  _restore-prompt) cmd_restore_prompt ;;
  forget) shift; cmd_forget "${1:-}" ;;
  new) shift; cmd_new "$@" ;;
  done) shift; cmd_done "$@" ;;
  _done) shift; cmd__done "$@" ;;
  ws) shift; cmd_ws "$@" ;;
  up) shift; cmd_up "$@" ;;
  move) shift; cmd_move "$@" ;;
  _move) shift; move_window "$@" ;;
  _resume-cmd) shift; resume_cmd "$@" ;;
  _autosave) shift; cmd__autosave "$@" ;;
  _reindex) shift; cmd__reindex "$@" ;;
  ot) shift; cmd_ot "$@" ;;
  _escalate) shift; cmd__escalate "$@" ;;
  _question) shift; cmd__question "$@" ;;
  install) shift; cmd_install "${1:-}" ;;
  doctor) cmd_doctor ;;
  demo) shift; cmd_demo "${1:-}" ;;
  keys)
    k() { tmux show -gqv "@pitwall-key-$1" 2>/dev/null || true; }
    cat <<EOF
In tmux (prefix, then)       also listed by tmux's own help, prefix ?
  $(printf '%-6s' "$(k dashboard | grep . || echo Space)") the dashboard: every lane, workspace and action
  $(printf '%-6s' "$(k next | grep . || echo a)") next lane that needs you; again to cycle
  $(printf '%-6s' "$(k restore | grep . || echo R)") restore the lanes a dead tmux took with it

In the dashboard             ? (with the search empty) shows these there too
  type             find lanes, workspaces, actions and commands; «rename ait» puts that action first
                   //text searches the lanes' output
  ctrl-n ctrl-e    down, up (the arrows too)
  ⏎                go to the lane · switch to the workspace · open the story · run the action
  1 2 3            answer the lane under the cursor when it asks (search empty)
  space            read the lane's whole output (search empty)
  ctrl + key       an action at once, even mid-search: ctrl-d diff · ctrl-o nvim · ctrl-g lazygit · ctrl-p PR
                   ctrl-s write · ctrl-w move · ctrl-r rename · ctrl-v select · ctrl-t worktree · ctrl-y copy resume · ctrl-x close
  shift-tab  →     every action on what is under the cursor, one key each (D branch diff · M move and go · a new lane
                   · i interrupt · R restart, and the ones above)
  tab              the other view: Lanes, OpenTimeline
  ctrl-f           lanes by workspace, or by state; remembered
  up · ctrl-u      the workspace recipes: ⏎ brings one up
  ctrl-v           select a lane (or type «select idle»); then ctrl-x, ctrl-w, ctrl-s act on all of them
  esc  ←           back: the actions, then the search, then the selection, then close (ctrl-c closes)
EOF
    ;;
  -v | --version | version) cat "$DIR/version.txt" ;;
  -h | --help | help | "") usage ;;
  *) echo "pitwall: unknown command $1" >&2; usage >&2; exit 1 ;;
esac
