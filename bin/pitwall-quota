#!/usr/bin/env python3
"""pitwall-quota [now]: CodexBar's usage JSON on stdin → two lines: a tmux-styled status segment, then plain text.

Each provider reads `claude 7% 5h · 34% wk`. A number turns white at 50%, amber at 80%, red at 95%. A window at
80% or more adds the time to its reset (`↻ 3h`), and a weekly pace that runs out before the reset adds `⚠ 2d`.
"""
import json
import sys
from datetime import datetime, timezone

MUTED, TEXT, AMBER, RED, DIM = "#9ca3af", "#e5e7eb", "#f59e0b", "#fb2c36", "#6b7280"


def colour(pct):
    return RED if pct >= 95 else AMBER if pct >= 80 else TEXT if pct >= 50 else MUTED


def span(seconds):
    seconds = max(0, int(seconds))
    if seconds >= 86400:
        return f"{seconds // 86400}d"
    if seconds >= 3600:
        return f"{seconds // 3600}h"
    return f"{max(1, seconds // 60)}m"


def until(iso, now):
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp() - now
    except (AttributeError, ValueError):
        return None


def main():
    now = float(sys.argv[1]) if len(sys.argv) > 1 else datetime.now(timezone.utc).timestamp()
    try:
        data = json.load(sys.stdin)
    except ValueError:
        return
    styled, plain = [], []
    for p in data if isinstance(data, list) else [data]:
        usage = p.get("usage") or {}
        windows = [(usage.get(key) or {}, unit) for key, unit in (("primary", "5h"), ("secondary", "wk"))]
        windows = [(w, unit) for w, unit in windows if w.get("usedPercent") is not None]
        if not windows:
            continue
        name = p.get("provider", "?")
        s_parts, p_parts = [], []
        for w, unit in windows:
            pct = round(w["usedPercent"])
            s_parts.append(f"#[fg={colour(pct)}]{pct}%#[fg={DIM}] {unit}")
            p_parts.append(f"{pct}% {unit}")
        s_text = f"#[fg={DIM}]{name} " + f"#[fg={DIM}] · ".join(s_parts)
        p_text = f"{name} " + " · ".join(p_parts)

        hot = max(windows, key=lambda wu: wu[0]["usedPercent"])[0]
        left = until(hot.get("resetsAt"), now)
        if hot["usedPercent"] >= 80 and left is not None:
            s_text += f" #[fg={AMBER}]↻ {span(left)}"
            p_text += f" ↻ {span(left)}"
        pace = (p.get("pace") or {}).get("secondary") or {}
        if pace.get("willLastToReset") is False and pace.get("etaSeconds"):
            s_text += f" #[fg={AMBER}]⚠ {span(pace['etaSeconds'])}"
            p_text += f" ⚠ {span(pace['etaSeconds'])}"
        styled.append(s_text)
        plain.append(p_text)
    if plain:
        print(f"#[fg={DIM}]   ".join(styled))
        print("   ".join(plain))


if __name__ == "__main__":
    main()
