#!/usr/bin/env python3
"""pitwall-quota [now]: CodexBar's usage JSON on stdin → three lines: a tmux-styled status segment, plain text, data.

Each provider reads `claude 5h 7% ↻3h · wk 34% ↻5d`: each window's use and the time left to its reset. A number
turns white at 50%, amber at 80%, red at 95%; a weekly use on course to run out before its reset is amber too.
"""
import json
import sys
from datetime import datetime, timezone

MUTED, TEXT, AMBER, RED, DIM = "#9ca3af", "#e5e7eb", "#f59e0b", "#fb2c36", "#6b7280"


def colour(pct):
    return RED if pct >= 95 else AMBER if pct >= 80 else TEXT if pct >= 50 else MUTED


def span(seconds):
    seconds = max(0, int(seconds))
    if seconds >= 86400:
        return f"{seconds // 86400}d"
    if seconds >= 3600:
        return f"{seconds // 3600}h"
    return f"{max(1, seconds // 60)}m"


def until(iso, now):
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp() - now
    except (AttributeError, ValueError):
        return None


def main():
    now = float(sys.argv[1]) if len(sys.argv) > 1 else datetime.now(timezone.utc).timestamp()
    try:
        data = json.load(sys.stdin)
    except ValueError:
        return
    styled, plain, rows = [], [], []
    for p in data if isinstance(data, list) else [data]:
        usage = p.get("usage") or {}
        windows = [(usage.get(key) or {}, unit) for key, unit in (("primary", "5h"), ("secondary", "wk"))]
        windows = [(w, unit) for w, unit in windows if w.get("usedPercent") is not None]
        if not windows:
            continue
        name = p.get("provider", "?")
        short = ((p.get("pace") or {}).get("secondary") or {}).get("willLastToReset") is False
        s_parts, p_parts = [], []
        for w, unit in windows:
            pct = round(w["usedPercent"])
            tint = colour(pct)
            if unit == "wk" and short and tint in (MUTED, TEXT):
                tint = AMBER  # on course to run out before the reset
            left = until(w.get("resetsAt"), now)
            rows.append(f"{name}:{unit}:{pct}:{int(now + left) if left is not None else 0}:{'short' if unit == 'wk' and short else 'ok'}")
            reset = "" if left is None else f" ↻{span(left)}" if left > 0 else " ↻due"
            s_parts.append(f"#[fg={DIM}]{unit} #[fg={tint}]{pct}%#[fg={DIM}]{reset}")
            p_parts.append(f"{unit} {pct}%{reset}")
        s_text = f"#[fg={DIM}]{name} " + f"#[fg={DIM}] · ".join(s_parts)
        p_text = f"{name} " + " · ".join(p_parts)
        styled.append(s_text)
        plain.append(p_text)
    if plain:
        print(f"#[fg={DIM}]   ".join(styled))
        print("   ".join(plain))
        print(" ".join(rows))  # for the dashboard's Usage view: provider:window:percent:reset-epoch:pace


if __name__ == "__main__":
    main()
