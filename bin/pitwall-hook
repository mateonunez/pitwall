#!/bin/sh
# pitwall-hook <Event> [harness]: called by Claude Code, Codex and Hermes hooks; sets the lane state on this pane.
# A window can hold several agents, so the state lives on the pane, never the window.
# Hot path: it runs on every tool call next to other hooks, so plain sh, two tmux calls when nothing changes,
# never the network. A change redraws every status line at once instead of waiting for status-interval.
# It also keeps the record `pitwall restore` needs, written only when the session changes and once per turn.

event=${1:-}
harness=${2:-}
input=$(cat 2>/dev/null) # drain the JSON the harness writes, so it never blocks on a full pipe

command -v tmux >/dev/null 2>&1 || exit 0

json_field() { # read a string field into value, in plain sh
  value=''
  case $input in *"\"$1\""*) ;; *) return ;; esac
  t=${input#*\"$1\"}
  t=${t#*\"}
  value=${t%%\"*}
}
json() { json_field "$1"; printf '%s' "$value"; }

TAB=$(printf '\t')
sid=$(json session_id)
case $sid in *[!A-Za-z0-9:_.-]*) exit 0 ;; esac

# A Hermes hook's cwd is the gateway's. The session's own directory may be in its state.db.
CWD=$(json cwd)
hermes_cwd=''
if [ "$harness" = hermes ]; then
  hermes_home=${HERMES_HOME:-$HOME/.hermes}
  if [ -n "$sid" ] && command -v sqlite3 >/dev/null 2>&1; then
    hermes_cwd=$(sqlite3 -readonly "$hermes_home/state.db" "select cwd from sessions where id = '$sid'" 2>/dev/null)
    [ -n "$hermes_cwd" ] && CWD=$hermes_cwd
  fi
fi

# /new leaves cwd empty in Hermes's database. Its client still records the exact session on its TTY.
hermes_terminal() {
  terminals=$(tmux list-panes -a -F "#{pane_id}$TAB#{pane_tty}$TAB#{pane_current_command}$TAB#{?#{@pitwall_harness},#{@pitwall_harness},-}$TAB#{pane_title}" 2>/dev/null) || return
  while IFS=$TAB read -r pane tty cmd agent title; do
    case $cmd:$agent:$title in hermes:* | python*:hermes:* | python*:*:hermes | python*:*:hermes\ *) ;; *) continue ;; esac
    case $tty in
      /dev/pts/*) key=tty-dev-pts-${tty##*/} ;;
      /dev/*) key=tty-dev-${tty##*/} ;;
      *) continue ;;
    esac
    input=''
    IFS= read -r input 2>/dev/null <"$hermes_home/terminal-sessions/$key" || [ -n "$input" ] || continue
    json_field session_id
    [ "$value" = "$sid" ] || continue
    if [ -n "$p" ] && [ "$p" != "$pane" ]; then p=ambiguous; return; fi
    p=$pane
  done <<EOF
$terminals
EOF
}

# Resolve an event without a trustworthy TMUX_PANE. Claude sometimes runs hooks without the tmux
# environment (a long, forked session); Codex runs them in its shared app-server daemon, whose TMUX_PANE is
# whatever pane first started it; Hermes runs them in its gateway, with no tmux at all. Prefer an exact
# session match (including Hermes's terminal record), then look in the session's directory.
resolve() {
  c=$CWD p=''
  if [ -n "$sid" ]; then
    p=$(tmux list-panes -a -f "#{==:#{@pitwall_session},$sid}" -F '#{pane_id}' 2>/dev/null |
      awk '!seen[$0]++ { p=$0; n++ } END { if (n == 1) print p; else if (n > 1) print "ambiguous" }')
    [ "$p" = ambiguous ] && return
    if [ -z "$p" ] && [ "$harness" = hermes ]; then
      hermes_terminal
      [ "$p" = ambiguous ] && return
    fi
  fi
  if [ -z "$p" ] && [ -n "$c" ]; then
    c=$(cd "$c" 2>/dev/null && pwd -P || printf '%s' "$c") # tmux reports the physical path (/private/var, not /var)
    t=''
    [ "$harness" = codex ] && [ -n "$sid" ] &&
      t=$(grep -F "\"id\":\"$sid\"" "${CODEX_HOME:-$HOME/.codex}/session_index.jsonl" 2>/dev/null | tail -1 | sed -n 's/.*"thread_name":"\([^"]*\)".*/\1/p')
    p=$(tmux list-panes -a -F "#{pane_id}$TAB#{pane_current_path}$TAB#{pane_current_command}$TAB#{?#{@pitwall_session},#{@pitwall_session},-}$TAB#{pane_title}" 2>/dev/null |
      awk -F '\t' -v c="$c" -v h="$harness" -v t="$t" -v e="$event" '
        !seen[$1]++ && $2 == c &&
          (h == "codex" ? $3 == "codex" : h == "hermes" ? ($5 ~ /^hermes/ || $3 ~ /^python/) : $3 ~ /^([0-9]+\.[0-9]+\.[0-9]+|claude|node)$/) {
          n++
          if (h == "codex" && $4 != "-" && e != "SessionStart") next
          p = $1; if (t != "" && index($5, t) == 1) { m++; q = $1 } }
        END { if (m == 1) print q; else if (n == 1) print p }')
  fi
  printf '%s' "$p"
}

idle_confirmation=''
case $event in
  SessionStart) state=idle ;;
  UserPromptSubmit | PreToolUse | PostToolUse) state=working ;;
  PermissionRequest) state=asking ;;
  Notification)
    case $(json notification_type) in
      permission_prompt | elicitation_dialog | elicitation_url_dialog) state=asking ;;
      idle_prompt)
        [ "$harness" = claude ] || exit 0
        state=stop idle_confirmation=1
        ;;
      *) exit 0 ;;
    esac
    ;;
  Stop)
    state=stop # idle or done, decided below by whether someone is looking at the lane
    # Only another agent keeps the lane working after the foreground turn ends.
    case $input in
      *'"background_tasks":[]'*) ;;
      *'"background_tasks"'*)
        n=$(printf '%s' "$input" | python3 -I -c 'import json, sys
print(sum(t.get("status") == "running" and t.get("type") in ("subagent", "teammate")
          for t in json.load(sys.stdin).get("background_tasks") or [] if isinstance(t, dict)))' 2>/dev/null)
        [ "${n:-0}" -gt 0 ] && state=working
        ;;
    esac
    ;;
  SessionEnd) state=gone ;;
  *) exit 0 ;;
esac

# Tab-separated, and no field may be empty: tabs are whitespace to `read`, so an empty one would shift the rest.
# (A control character would be safer, but tmux before 3.5 prints it escaped.) "-" stands for empty.
pane_info() {
  [ -n "$TMUX_PANE" ] || return 1
  info=$(tmux display -p -t "$TMUX_PANE" "#{?#{@pitwall_state},#{@pitwall_state},-}$TAB#{?#{@pitwall_session},#{@pitwall_session},-}$TAB#{window_id}$TAB#{?window_name,#{window_name},-}$TAB#{window_panes}$TAB#{pane_index}$TAB#{session_name}$TAB#{window_index}$TAB#{pid}$TAB#{?#{@pitwall-toast},#{@pitwall-toast},-}$TAB#{?#{@pitwall_quota_at},#{@pitwall_quota_at},0}$TAB#{?#{@pitwall-urgent-after},#{@pitwall-urgent-after},600}$TAB#{?#{@pitwall_since},#{@pitwall_since},0}$TAB#{?pane_current_path,#{pane_current_path},-}" 2>/dev/null) || return 1
  case $info in *"$TAB@"*) ;; *) return 1 ;; esac # tmux 3.7 prints empty fields, and exits 0, for a pane that is gone
}
resolved_pane=''
if pane_info; then
  if [ "$harness" = codex ] && [ -n "$sid" ]; then
    hinted=${info#*"$TAB"}
    [ "${hinted%%"$TAB"*}" = "$sid" ] || { TMUX_PANE=$(resolve) && pane_info || exit 0; }
  fi
else
  TMUX_PANE=$(resolve) && pane_info || exit 0
  resolved_pane=1
fi
IFS=$TAB read -r current stored win wname panes pidx sname widx server toast quota_at urgent_after since pane_cwd <<EOF
$info
EOF
[ "$harness" = hermes ] && [ -n "$resolved_pane" ] && [ -z "$hermes_cwd" ] && [ "$pane_cwd" != - ] && CWD=$pane_cwd
[ "$current" = - ] && current=''
[ "$stored" = - ] && stored=''
[ "$harness" = codex ] && [ -n "$sid" ] && [ -n "$stored" ] && [ "$stored" != "$sid" ] && [ "$event" != SessionStart ] && exit 0
[ "$wname" = - ] && wname=''
[ "$toast" = - ] && toast=''
# An idle notification can settle a stuck spinner for its own session, never an unread mark or a permission.
if [ -n "$idle_confirmation" ]; then
  [ "$current" = working ] && [ -n "$sid" ] && [ "$sid" = "$stored" ] || exit 0
fi
fresh=''
[ -n "$sid" ] && [ "$sid" != "$stored" ] && fresh=1
# Nothing changed: leave now, unless the event keeps the saved record (once per turn, and at exit).
case $event in Stop | SessionEnd) ;; *) [ "$current" = "$state" ] && [ -z "$fresh" ] && exit 0 ;; esac

now=$(date +%s)
name=$wname
[ "${panes:-1}" -gt 1 ] && name="$wname.$pidx"
sid=${sid:-$stored}

# The record `pitwall restore` reads after a crash: one file per agent session, replaced atomically.
record() {
  [ -n "$sid" ] || return 0
  dir=${XDG_STATE_HOME:-$HOME/.local/state}/pitwall/lanes
  [ -d "$dir" ] || mkdir -p "$dir" 2>/dev/null || return 0
  cwd=$CWD
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$harness" "$sid" "${cwd:-$PWD}" "$sname" "$widx" "$wname" "$pidx" "$server" "$now" \
    >"$dir/$sid.tmp" 2>/dev/null && mv -f "$dir/$sid.tmp" "$dir/$sid"
}
forget() { rm -f "${XDG_STATE_HOME:-$HOME/.local/state}/pitwall/lanes/$sid" 2>/dev/null; }

if [ -n "$fresh" ]; then
  tmux set -p -t "$TMUX_PANE" @pitwall_session "$sid" ';' set -p -t "$TMUX_PANE" @pitwall_transcript "$(json transcript_path)" >/dev/null 2>&1
  record
  # a new session in a workspace saved as a recipe: the recipe follows it
  [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/pitwall/up/$sname.toml" ] &&
    tmux run-shell -b "'$(cd "$(dirname "$0")" && pwd)/pitwall' _autosave '$sname'" >/dev/null 2>&1
fi
case $event in
  Stop) record ;; # once per turn: keeps the window and pane position current
  SessionEnd)
    # A deliberate exit is not restored; anything else (the server died, a signal) keeps the record.
    case $(json reason) in clear | logout | prompt_input_exit) forget ;; esac
    ;;
esac
# An ending session is not an ending agent: /clear, a resume, or Hermes reaping a session it left behind end one
# while the program runs on. So gone only when the pane is back at a shell a moment later (## keeps tmux from
# expanding the format now).
if [ "$event" = SessionEnd ] && [ -z "${PITWALL_GONE_CHECKED:-}" ]; then
  bin=$(cd "$(dirname "$0")" && pwd)
  tmux run-shell -b "sleep 2; case \$(tmux display -p -t '$TMUX_PANE' '##{pane_current_command}' 2>/dev/null) in zsh | -zsh | bash | -bash | fish | sh | -sh | dash | login) printf '{\"session_id\":\"$sid\"}' | PITWALL_GONE_CHECKED=1 TMUX_PANE='$TMUX_PANE' '$bin/pitwall-hook' SessionEnd '$harness' ;; esac" >/dev/null 2>&1
  exit 0
fi
[ "$current" = "$state" ] && exit 0

viewers=$(tmux list-clients -f "#{==:#{window_id},$win}" -F '#{client_name}' 2>/dev/null)
if [ "$state" = stop ]; then
  # Finished while you look at it: idle. Finished while you are elsewhere: done, the unread mark.
  if [ -n "$viewers" ]; then state=idle; else state=done; fi
  [ "$current" = "$state" ] && exit 0
fi

case $state in
  asking) msg="◆ $name needs you" ;;
  done) msg="✓ $name finished" ;;
  *) msg='' ;;
esac
[ "$toast" = off ] && msg=''

if [ -n "$idle_confirmation" ]; then
  # Check and write in the same tmux command so a newer permission request always wins.
  case "${TMUX_PANE#%}:$sid:$since" in *[!A-Za-z0-9:_.-]*) exit 0 ;; esac
  case ${TMUX_PANE#%} in '' | *[!0-9]*) exit 0 ;; esac
  guard="#{&&:#{==:#{@pitwall_state},working},#{&&:#{==:#{@pitwall_session},$sid},#{==:#{@pitwall_since},$since}}}"
  applied=$(tmux if-shell -F -t "$TMUX_PANE" "$guard" \
    "set -p -t $TMUX_PANE @pitwall_state $state; set -p -t $TMUX_PANE @pitwall_since $now; display-message -p yes" 2>/dev/null)
  [ "$applied" = yes ] || exit 0
  set --
else
  set -- set -p -t "$TMUX_PANE" @pitwall_state "$state" ';' \
  set -p -t "$TMUX_PANE" @pitwall_since "$now" ';' \
  set -p -t "$TMUX_PANE" @pitwall_harness "$harness" ';' \
  set -p -t "$TMUX_PANE" @pitwall_name "$(d=${CWD:-$PWD}; printf '%s' "${d##*/}")" ';' \
  set -pu -t "$TMUX_PANE" @pitwall_urgent ';' \
  set -pu -t "$TMUX_PANE" @pitwall_question ';' \
  set -pu -t "$TMUX_PANE" @pitwall_choices
fi
for c in $(tmux list-clients -F '#{client_name}' 2>/dev/null); do
  [ "$#" -eq 0 ] || set -- "$@" ';'
  set -- "$@" refresh-client -S -t "$c"
  # A toast only for clients that are not already looking at the lane.
  if [ -n "$msg" ]; then
    case " $(echo $viewers) " in *" $c "*) ;; *) set -- "$@" ';' display-message -c "$c" -d 3000 "$msg" ;; esac
  fi
done
[ "$#" -eq 0 ] || tmux "$@" >/dev/null 2>&1

# Today's ledger, one line per state change (time, pane, session, lane, state): where the day went, for
# `pitwall stats --today` and the dashboard's Usage view. A new day's file prunes the ones older than two weeks.
ledger=${XDG_STATE_HOME:-$HOME/.local/state}/pitwall/ledger
day=$ledger/$(date +%F)
[ -f "$day" ] || { mkdir -p "$ledger" 2>/dev/null; find "$ledger" -type f -mtime +14 -delete 2>/dev/null; }
printf '%s\t%s\t%s\t%s\t%s\n' "$now" "$TMUX_PANE" "${sid:--}" "$name" "$state" >>"$day" 2>/dev/null

bin=$(cd "$(dirname "$0")" && pwd)
# Plugins that listen to lane.state get the change, each in the background (OpenTimeline turns it into a signal).
[ -s "${XDG_STATE_HOME:-$HOME/.local/state}/pitwall/plugins.tsv" ] && "$bin/pitwall" _emit lane.state "$TMUX_PANE" "${current:--}" "$state" >/dev/null 2>&1
# The spinner animates only while something works; the ticker exits on its own afterwards.
[ "$state" = working ] && tmux run-shell -b "'$bin/pitwall-tick'" >/dev/null 2>&1
# A lane that starts asking: its question read off the screen once it is drawn, and a toast that says it.
[ "$state" = asking ] && tmux run-shell -b "sleep 0.6; '$bin/pitwall' _question '$TMUX_PANE' '$now'" >/dev/null 2>&1
# A lane that starts asking gets one check, ten minutes on (no polling): still asking since then means urgent.
[ "$state" = asking ] && [ "${urgent_after:-0}" -gt 0 ] &&
  tmux run-shell -b "sleep $urgent_after; '$bin/pitwall' _escalate '$TMUX_PANE' '$now'" >/dev/null 2>&1
# When a turn ends, usage limits older than ten minutes refresh. No polling.
case $state in
  done | idle) [ $((now - ${quota_at:-0})) -gt 600 ] && tmux run-shell -b "'$bin/pitwall' quota --refresh" >/dev/null 2>&1 ;;
esac
exit 0
