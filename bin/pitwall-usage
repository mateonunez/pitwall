#!/usr/bin/env python3
"""Read a complete Usage sample in the background. The dashboard joins rows to current lane identities."""
import hashlib
import os
from pathlib import Path
import subprocess
import sys
import time

BIN = Path(__file__).resolve().parent
sys.path.insert(0, str(BIN.parent / "lib"))
from pitwall_panel import Snapshot, preview

US = "\x1f"


def main():
    lanes, server, preview_path = sys.argv[1:]
    day = time.strftime("%Y-%m-%d")
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    socket = os.environ.get("TMUX", "").rsplit(",", 2)[0]
    slot = "usage:" + hashlib.sha256(socket.encode()).hexdigest()
    snapshot = Snapshot(slot, [server, state, day, 1])
    cached = snapshot.read()
    if cached is not None:
        preview(preview_path, cached)
    records = []
    identities = {}
    try:
        for line in Path(lanes).read_text().split("\n"):
            if not line:
                continue
            fields = line.split(US)
            pane, harness, transcript, sid = fields[4], fields[6], fields[8], fields[9]
            identities[pane] = [pane, harness, transcript, sid]
            metrics = subprocess.check_output([BIN / "pitwall-stats", harness, transcript, sid], text=True)
            records.append(US.join(["tokens", pane, harness, transcript, sid, metrics.rstrip("\n").replace("\t", US)]))
        ledger = subprocess.check_output([BIN / "pitwall", "stats", "--today", "--plain"], text=True)
        for line in ledger.splitlines():
            pane, _, worked, waited = line.split("\t")
            if pane in identities:
                records.append(US.join(["time", *identities[pane], worked, waited]))
        if day != time.strftime("%Y-%m-%d"):
            return 1
    except (OSError, subprocess.CalledProcessError, IndexError, ValueError):
        return 1
    output = "\n".join(records) + "\n"
    snapshot.save(output)
    sys.stdout.write(output)
    return 0


if __name__ == "__main__":
    sys.exit(main())
