#!/usr/bin/env bash
# pitwall-ws [move "<window-id> …" <label>]: pick a workspace (a tmux session) to switch to, or to move a lane into.
# Keys follow Colemak + vim: n/e move, i or ⏎ choose, c create a new one, r rename (switch only), h/q/esc close.
# Runs in a popup (prefix W), or inside the board when you press m there. Works on bash 3.2 and 5.

PITWALL="$(cd "$(dirname "$0")" && pwd)/pitwall"
E=$'\033'
AMBER="${E}[38;2;245;158;11m" GREEN="${E}[38;2;0;199;88m" TEXT="${E}[38;2;229;231;235m"
MUTED="${E}[38;2;156;163;175m" DIM="${E}[38;2;107;114;128m" SELBG="${E}[48;2;38;38;38m" CHIP="${E}[48;2;55;55;55m"
BOLD="${E}[1m" R="${E}[0m" EOL="${E}[K"

mode=switch window='' lane=''
[ "${1:-}" = move ] && mode=move window=$2 lane=$3
here=$(tmux display -p '#{client_session}' 2>/dev/null)
[ "$mode" = move ] && here=$(tmux display -p -t "${window%% *}" '#{session_name}' 2>/dev/null)
pending='' sel=0 W_name=() W_attached=() W_windows=() W_ask=() W_done=() W_work=() W_idle=()

load() {
  local name attached windows ask done work idle
  W_name=() W_attached=() W_windows=() W_ask=() W_done=() W_work=() W_idle=()
  while IFS=$'\t' read -r name attached windows ask done work idle; do
    W_name+=("$name") W_attached+=("$attached") W_windows+=("$windows")
    W_ask+=("$ask") W_done+=("$done") W_work+=("$work") W_idle+=("$idle")
  done < <("$PITWALL" ws _rows 2>/dev/null)
  ((sel >= ${#W_name[@]})) && sel=$((${#W_name[@]} - 1))
  ((sel < 0)) && sel=0
}

key() { printf '%s %s %s %s%s   ' "${CHIP}${TEXT}" "$1" "$R" "${MUTED}$2" "$R"; }

draw() {
  local i bg mark lanes row out="${E}[H${EOL}"$'\n'
  if [ "$mode" = move ]; then
    out+="  ${BOLD}${TEXT}move ${AMBER}${lane}${TEXT} to${R}  ${DIM}its agents keep running${R}${EOL}"$'\n'
  else
    out+="  ${BOLD}${TEXT}pit${AMBER}wall${R}  ${MUTED}workspaces${R}${EOL}"$'\n'
  fi
  out+="${EOL}"$'\n'
  for ((i = 0; i < ${#W_name[@]}; i++)); do
    bg='' mark=' '
    ((i == sel)) && bg=$SELBG mark="${AMBER}▌"
    lanes=''
    ((W_ask[i])) && lanes+="${BOLD}${AMBER}◆ ${W_ask[i]}${R}${bg}  "
    ((W_done[i])) && lanes+="${BOLD}${GREEN}✓ ${W_done[i]}${R}${bg}  "
    ((W_work[i])) && lanes+="${TEXT}⠙ ${W_work[i]}${R}${bg}  "
    ((W_idle[i])) && lanes+="${MUTED}○ ${W_idle[i]}${R}${bg}  "
    printf -v row '%s%s %s%-20.20s%s %s%2d window%s%s  %s' "$bg" "$mark" "$TEXT" "${W_name[i]}" "${R}${bg}" "$DIM" "${W_windows[i]}" \
      "$( ((W_windows[i] == 1)) && printf ' ' || printf 's')" "${R}${bg}" "$lanes"
    [ "${W_name[i]}" = "$here" ] && row+="${DIM}$([ "$mode" = move ] && echo 'here now' || echo 'you are here')${R}${bg}"
    out+="$row${EOL}${R}"$'\n'
  done
  out+="${E}[J"
  printf -v row '%s[%d;1H  %s%s%s%s' "$E" "$(tput lines)" "$(key 'n e' move)" "$(key 'i ⏎' "$([ "$mode" = move ] && echo 'move here' || echo go)")" \
    "$(key c new)" "$([ "$mode" = switch ] && key r rename)$(key 'h q' close)"
  printf '%s%s' "$out" "$row"
}

ask() { # ask <prompt> → $answer, read on the bottom line with the cursor shown
  printf '%s[%d;1H%s[2K  %s%s%s ' "$E" "$(tput lines)" "$E" "$AMBER" "$1" "$R"
  printf '%s[?25h' "$E"
  stty echo icanon 2>/dev/null
  IFS= read -r answer
  stty -echo -icanon 2>/dev/null
  printf '%s[?25l' "$E"
  answer=${answer//[^A-Za-z0-9._-]/-} # tmux session names: keep them plain
}

choose() { # act on a workspace name
  if [ "$mode" = move ]; then
    local w
    for w in $window; do # every window of the selection; one already there stays
      [ "$(tmux display -p -t "$w" '#{session_name}' 2>/dev/null)" = "$1" ] && continue
      "$PITWALL" _move "$w" "$1" >/dev/null
    done
  else
    tmux switch-client -t "=$1"
  fi
  exit 0
}

trap 'printf "%s[?25h%s[?7h" "$E" "$E"; stty echo icanon 2>/dev/null' EXIT
printf '%s[?25l%s[?7l%s[2J' "$E" "$E" "$E"
load
while :; do
  draw
  if [ -n "$pending" ]; then k=${pending:0:1} pending=${pending:1}; else IFS= read -rsn1 k || exit 0; fi
  if [ "$k" = "$E" ]; then # an arrow, or esc: what followed that is not an arrow is played back as keys
    rest='' r2=''
    IFS= read -rsn1 -t 1 rest
    [ "$rest" = '[' ] && IFS= read -rsn1 -t 1 r2 && rest+=$r2
    case $rest in '[A') k=e ;; '[B') k=n ;; '[C') k=i ;; '[D') k=h ;; '') exit 0 ;; *) exit 0 ;; esac
  fi
  case $k in
    n | j) ((sel < ${#W_name[@]} - 1)) && sel=$((sel + 1)) ;;
    e | k) ((sel > 0)) && sel=$((sel - 1)) ;;
    i | '') ((${#W_name[@]})) && choose "${W_name[sel]}" ;;
    c)
      ask 'new workspace:'
      [ -n "$answer" ] || continue
      if [ "$mode" = move ]; then choose "$answer"; fi
      tmux new-session -d -s "$answer" -c "$HOME" 2>/dev/null
      load
      ;;
    r)
      [ "$mode" = switch ] || continue
      ask "rename ${W_name[sel]} to:"
      [ -n "$answer" ] && "$PITWALL" ws rename "${W_name[sel]}" "$answer" >/dev/null
      load
      ;;
    h | q) exit 0 ;;
  esac
done
